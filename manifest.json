{
  "manifest_version": 2,
  "name": "Extensions par espace",
  "version": "1.1.0",
  "description": "Active certaines extensions seulement dans certains espaces Zen.",
  "browser_specific_settings": {
    "gecko": { "id": "zen-space-addons@local" }
  },
  "permissions": ["management", "storage"],
  "background": { "scripts": ["health.js", "background.js"] },
  "browser_action": {
    "default_title": "Extensions par espace",
    "default_popup": "grid.html",
    "default_icon": "icon.svg"
  },
  "options_ui": { "page": "grid.html" },
  "icons": { "48": "icon.svg" },
  "experiment_apis": {
    "zenSpaceAddons": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["zenSpaceAddons"]],
        "script": "api/parent.js"
      }
    }
  }
}
